# ---------------------------------------------------------------------------
# Kenzory environment variables  (copy to .env and fill in real values)
# ---------------------------------------------------------------------------

# Runtime environment: development | testing | production
KENZORY_ENV=development

# Random 32+ character secret. REQUIRED in production.
SECRET_KEY=change-me

# SQLAlchemy database URL. Defaults to a local SQLite file in development.
# Production must set this, e.g.:
# DATABASE_URL=postgresql+psycopg2://kenzory:password@localhost:5432/kenzory
# DATABASE_URL=

# Outer URL / cookie hardening (production defaults to secure HTTPS cookies)
# PREFERRED_URL_SCHEME=https
# SESSION_COOKIE_SECURE=true

# SMTP settings for Flask-Mail (contact/award notifications).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@kenzory.org
# Keep emails suppressed during development; set false in production.
MAIL_SUPPRESS_SEND=true

# First-run seed credentials (only used when the database is empty).
# If left blank, the seeder falls back to dev credentials — set these before
# your first production deploy!
KENZORY_ADMIN_PASSWORD=
KENZORY_SEED_PASSWORD=

# Docker Compose only: password for the kenzory Postgres container.
POSTGRES_PASSWORD=kenzory-dev-password

# Dev server port (app.py only; gunicorn/Docker use 8000).
# PORT=8081